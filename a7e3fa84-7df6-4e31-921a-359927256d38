@tailwind base;
@tailwind components;
@tailwind utilities;

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
}

::-webkit-scrollbar {
  width: 8px;
}
::-webkit-scrollbar-track {
  background: #020712;
}
::-webkit-scrollbar-thumb {
  background: #1b4a8c;
  border-radius: 999px;
}
::-webkit-scrollbar-thumb:hover {
  background: #2563eb;
}
